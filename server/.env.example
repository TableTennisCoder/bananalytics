# Bananalytics configuration.
#
#   cp .env.example .env
#
# Then fill in the two values marked REQUIRED below. `docker compose` refuses to
# start without them rather than falling back to insecure defaults.

# ── REQUIRED ──────────────────────────────────────────────────────────────────

# Password for the PostgreSQL user. Generate a fresh one:
#
#   openssl rand -hex 24
#
# Use hex or alphanumeric only — the password goes into a connection URL, so
# characters like @ : / # would have to be percent-encoded.
#
# NOTE for existing installations: Postgres only reads this when it initialises
# an empty data directory. Changing it later does not change the password of an
# already-created user — see "Rotating the database password" in README.md.
BANANA_DB_PASSWORD=

# Origins allowed to call the API from a browser, comma-separated. Use your
# dashboard's origin. Native mobile apps do not send an Origin header and are
# unaffected by this, so there is no reason to widen it for the SDK.
#   e.g. https://analytics.myapp.com
BANANA_CORS_ORIGINS=

# ── Deployment ────────────────────────────────────────────────────────────────

# Domain for HTTPS. Caddy provisions a Let's Encrypt certificate for it, so the
# DNS A record must already point at this server before the first start.
# Leave as localhost for local runs (Caddy then serves a self-signed cert).
BANANA_DOMAIN=localhost

# ── Optional ──────────────────────────────────────────────────────────────────

# MaxMind license key for GeoIP downloads. Without it the geography page and the
# 3D globe stay empty; everything else works.
# Free signup: https://www.maxmind.com/en/geolite2/signup
# Then run: ./scripts/download-geoip.sh
MAXMIND_LICENSE_KEY=

# Database user and name. Only read when the data directory is first created.
BANANA_DB_USER=bananalytics
BANANA_DB_NAME=bananalytics

# Log verbosity: debug, info, warn, error.
BANANA_LOG_LEVEL=info

# ── Backups (see scripts/backup.sh) ───────────────────────────────────────────

# Where dumps are written. Put this on a volume you actually back up, or pair it
# with the off-site upload below — a backup on the same disk as the database
# does not survive losing that disk.
BANANA_BACKUP_DIR=./backups

# How many days of dumps to keep locally.
BANANA_BACKUP_RETENTION_DAYS=14

# Optional off-site copy. Any rclone remote works (S3, B2, Storj, Drive, ...):
#   rclone config          # one-time, creates the remote
#   BANANA_BACKUP_REMOTE=b2:my-bucket/bananalytics
# Leave empty to keep backups local only.
BANANA_BACKUP_REMOTE=
